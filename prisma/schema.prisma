generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENTE
  VOLUNTARIO
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  REALIZADO
  CANCELADO
}


enum StatusDocumento {
  PENDENTE
  APROVADO
  REJEITADO
}

enum TipoNotificacao {
  AGENDAMENTO
  PAGAMENTO
  CHAT
  AVALIACAO
  SISTEMA
}
model User {
  id          Int      @id @default(autoincrement())

  email       String   @unique
  senha       String
  role        Role     @default(CLIENTE)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  perfil Perfil?
}

model Perfil {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  nome        String
  telefone    String?
  endereco    String?
  cpf         String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  voluntario Voluntario?

  // AGENDAMENTOS
  agendamentosCliente Agendamento[]
  agendamentosVoluntario Agendamento[] @relation("AgendamentoVoluntario")

  // AVALIAÇÕES
  avaliacoes Avaliacao[]

  // NOTIFICAÇÕES
  notificacoes Notificacao[]

  // AUDITORIA
  auditoriaLogs AuditoriaLog[]
}

model Voluntario {
  id              Int      @id @default(autoincrement())
  perfilId        Int      @unique
  categoriaId     Int?
  formacao        String?
  bio             String?
  experiencia     Int?
  avaliacaoMedia  Float    @default(0)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  disponibilidades Disponibilidade[]

  documentos Documento[]

  servicos VoluntarioServico[]
  postagens Postagem[]
  avaliacoesRecebidas Avaliacao[]

  @@index([categoriaId])
}

model Categoria {
  id          Int      @id @default(autoincrement())

  nome        String   @unique
  descricao   String?

  ativo       Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  voluntarios Voluntario[]
}

model Disponibilidade {
  id                  Int      @id @default(autoincrement())

  voluntarioId        Int

  diaSemana           Int

  horaInicio          String
  horaFim             String

  intervaloMinutos    Int      @default(30)

  ativo               Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  voluntario Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)

  @@unique([voluntarioId, diaSemana])
}

model Servico {
  id              Int      @id @default(autoincrement())

  nome            String
  descricao       String?

  preco           Float
  duracao         Int?

  ativo           Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agendamentos Agendamento[]

  voluntarios VoluntarioServico[]

  agendamentoServicos AgendamentoServico[]
}

model Agendamento {
  id                    Int      @id @default(autoincrement())

  clientePerfilId       Int
  voluntarioPerfilId    Int

  servicoId             Int?

  titulo                String?
  descricao             String?

  dataInicio            DateTime
  dataFim               DateTime?

  status                StatusAgendamento @default(AGENDADO)

  local                 String?
  notas                 String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cliente Perfil @relation(fields: [clientePerfilId], references: [id], onDelete: Cascade)

  voluntario Perfil @relation("AgendamentoVoluntario", fields: [voluntarioPerfilId], references: [id], onDelete: Cascade)

  servico Servico? @relation(fields: [servicoId], references: [id], onDelete: SetNull)

  servicos AgendamentoServico[]

  @@index([clientePerfilId])
  @@index([voluntarioPerfilId])
  @@index([servicoId])
}

model Avaliacao {
  id                Int      @id @default(autoincrement())

  perfilId          Int
  voluntarioId      Int?

  agendamentoId     Int?

  classificacao     Int
  comentario        String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  voluntario Voluntario? @relation(fields: [voluntarioId], references: [id], onDelete: SetNull)

  @@unique([perfilId, agendamentoId])

  @@index([voluntarioId])
}


model Postagem {
  id                Int      @id @default(autoincrement())

  voluntarioId      Int

  titulo            String
  conteudo          String

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  voluntario Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)

  @@index([voluntarioId])
}

model Notificacao {
  id          Int             @id @default(autoincrement())

  perfilId    Int

  titulo      String
  mensagem    String

  tipo        TipoNotificacao

  lido        Boolean         @default(false)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([perfilId])
}

model AuditoriaLog {
  id        Int      @id @default(autoincrement())

  perfilId  Int?
  acao      String
  tabela    String
  dados     Json?

  createdAt DateTime @default(now())

  perfil Perfil? @relation(fields: [perfilId], references: [id], onDelete: SetNull)

  @@index([perfilId])
}


model Documento {
  id                  Int      @id @default(autoincrement())

  voluntarioId        Int
  tipoDocumentoId     Int

  caminhoArquivo      String
  nomeArquivo         String

  statusValidacao     StatusDocumento @default(PENDENTE)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  voluntario Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)

  tipoDocumento TipoDocumento @relation(fields: [tipoDocumentoId], references: [id], onDelete: Cascade)
}

model TipoDocumento {
  id              Int      @id @default(autoincrement())

  nome            String   @unique

  obrigatorio     Boolean  @default(false)

  ativo           Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documentos Documento[]
}

model VoluntarioServico {
  id              Int      @id @default(autoincrement())

  voluntarioId    Int
  servicoId       Int

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  voluntario Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)

  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([voluntarioId, servicoId])
}

model AgendamentoServico {
  id              Int      @id @default(autoincrement())

  agendamentoId   Int
  servicoId       Int

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([agendamentoId, servicoId])
}